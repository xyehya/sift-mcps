.DS_Store
._.DS_Store
**/.venv/
**/__pycache__/
**/*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
coverage/
.coverage
.coverage-reports/
.coverage-*.json
*.log
.env
.env.*
!.env.example

# Evidence files — never commit real forensic evidence
*.E01
*.e01

# Code knowledge-graph artifacts (understand-anything) — local tooling, not source
.understand-anything/

# Playwright MCP render scratch (excalidraw export)
.playwright-mcp/

# Skill bodies live here locally; tracked symlinks under .claude/skills and
# .cursor/skills point at these paths. Populate via /setup-matt-pocock-skills
# (or your usual skills installer) — not committed as file trees.
.agents/

# Machine-local skills lockfile (linear-cli skills) — not shared
skills-lock.json

# Project agent wiring is committed under .cursor/ and .claude/settings.json /
# .mcp.json / opencode.json / .codex/config.toml (PATH-based MCP commands only;
# no machine-absolute binary paths). Keep only machine-local Claude hooks and
# personal skill overlays gitignored below.
.claude/hooks/cbm-code-discovery-gate
.claude/hooks/cbm-session-reminder
.claude/skills/codebase-memory/
.claude/skills/linear-cli/
.claude/skills/supabase-postgres-best-practices/

# Portal v3 internal ops docs — kept OUT of the pushable repo; live in the
# local ops hub ~/AI/sift-portal-ops/ (trackers, runbooks, audits,
# design source, operating model). Repo carries code + contracts only.
packages/case-dashboard/frontend/design/
/security_report/

# Local design-review screenshots + agent session artifacts — personal/local,
# not shared. (Root-level loose PNGs are also ignored via .git/info/exclude.)
/design-captures/
.claude/agent-memory/
ide-rules-codex.zip
