#!/usr/bin/python3
"""Root-owned, argument-validating systemd broker for stdio MCP add-ons."""

from __future__ import annotations

import os
import pwd
import re
import secrets
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import NoReturn


def fail(message: str) -> NoReturn:
    print(f"sift-addon-systemd-sandbox: {message}", file=sys.stderr)
    raise SystemExit(2)


def environment_line(name: str, value: str) -> str:
    if "\n" in value or "\r" in value:
        fail("environment value contains a newline")
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'{name}="{escaped}"\n'


def validate_fifo(raw: str, service_uid: int, prefix: str, expected_mode: int) -> Path:
    path = Path(raw)
    if path.parent != Path("/run/sift-addon-client") or re.fullmatch(
        rf"{prefix}\.[0-9a-f]{{32}}", path.name
    ) is None:
        fail("invalid relay FIFO path")
    info = path.lstat()
    if not stat.S_ISFIFO(info.st_mode) or info.st_uid != service_uid or stat.S_IMODE(info.st_mode) != expected_mode:
        fail("relay endpoint ownership/type/mode check failed")
    return path


def read_relay_environment(approved: frozenset[str]) -> dict[str, str]:
    """Read the relay's bounded credential payload from stdin.

    The relay passes a dedicated one-shot pipe as the broker's stdin. The
    actual add-on stdio channel continues to use the separately validated,
    pinned FIFOs below. This avoids both a credential file that needs a DAC
    exception and a sudo environment hop that could enter journal metadata.
    """
    data = sys.stdin.buffer.read(32769)
    if len(data) > 32768:
        fail("relay environment payload is too large")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("relay environment payload is not UTF-8")

    values: dict[str, str] = {}
    for line in text.splitlines():
        if not line:
            continue
        if "=" not in line:
            fail("relay environment payload is malformed")
        name, value = line.split("=", 1)
        if name not in approved or name in values or "\x00" in value:
            fail("relay environment payload is not approved")
        values[name] = value
    return values


def main() -> int:
    if os.geteuid() != 0:
        fail("must run as root")
    try:
        apparmor_label = Path("/proc/self/attr/current").read_text(
            encoding="utf-8"
        ).strip()
    except OSError as exc:
        fail(f"cannot verify AppArmor broker attachment: {exc}")
    if apparmor_label != "sift-addon-broker (enforce)":
        fail("AppArmor broker attachment is not enforced")
    if len(sys.argv) != 11 or sys.argv[1] != "--backend-name" or sys.argv[3] != "--network-policy" or sys.argv[5] != "--stdin-path" or sys.argv[7] != "--stdout-path" or sys.argv[9] != "--":
        fail("invalid invocation shape")
    backend_name, network_policy = sys.argv[2], sys.argv[4]
    command_path = sys.argv[10]
    if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", backend_name) is None:
        fail("invalid backend name")
    if network_policy not in {"none", "loopback"}:
        fail("invalid network policy")

    service_user = os.environ.get("SUDO_USER", "")
    if service_user == "root" or re.fullmatch(r"[a-z_][a-z0-9_-]*[$]?", service_user) is None:
        fail("invalid invoking service user")
    account = pwd.getpwnam(service_user)
    input_path = validate_fifo(sys.argv[6], account.pw_uid, "stdin", 0o644)
    output_path = validate_fifo(sys.argv[8], account.pw_uid, "stdout", 0o622)
    service_group = str(account.pw_gid)

    resolved_command = str(Path(command_path).resolve(strict=True))
    policies: dict[str, tuple[str, str, frozenset[str]]] = {
        "/opt/sift-mcps/.venv/bin/opensearch-mcp": (
            "opensearch-mcp",
            "loopback",
            frozenset({"OPENSEARCH_CONFIG", "OPENSEARCH_HOST"}),
        ),
        "/opt/sift-mcps/.venv/bin/windows-triage-mcp": (
            "windows-triage-mcp",
            "none",
            frozenset({"WT_DATA_DIR"}),
        ),
        "/opt/sift-mcps/.venv/bin/opencti-mcp": (
            "opencti-mcp",
            "loopback",
            frozenset({"OPENCTI_URL", "OPENCTI_TOKEN"}),
        ),
    }
    policy = policies.get(resolved_command)
    if policy is None:
        fail("command is not an approved installed add-on launcher")
    expected_backend, expected_network, approved_env = policy
    if (backend_name, network_policy) != (expected_backend, expected_network):
        fail("backend command/network policy mismatch")
    relay_env = read_relay_environment(approved_env)

    run_dir = Path("/run/sift-addon")
    run_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(run_dir, 0o700)
    env_path: Path | None = None
    input_fd: int | None = None
    output_fd: int | None = None
    try:
        # Pin validated FIFO objects before asking PID 1 to open them. Refer to
        # these broker-owned handles below so a compromised service user cannot
        # replace a path between validation and transient-unit creation.
        input_fd = os.open(input_path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        output_fd = os.open(output_path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", prefix="environment.", dir=run_dir, delete=False
        ) as env_file:
            env_path = Path(env_file.name)
            for name in sorted(approved_env):
                value = relay_env.get(name)
                if value:
                    env_file.write(environment_line(name, value))
            env_file.write(environment_line("HOME", "/tmp"))
            env_file.write(environment_line("USER", service_user))
            env_file.write(environment_line("LOGNAME", service_user))
        os.chmod(env_path, 0o600)

        nonce = secrets.token_hex(8)
        unit_name = f"sift-addon-{backend_name}-{nonce}.service"
        systemd_args = [
            "/usr/bin/systemd-run",
            "--wait",
            "--quiet",
            "--collect",
            "--service-type=exec",
            f"--unit={unit_name}",
            f"--property=User={service_user}",
            f"--property=Group={service_group}",
            "--property=AppArmorProfile=sift-addon",
            "--property=NoNewPrivileges=yes",
            "--property=CapabilityBoundingSet=",
            "--property=AmbientCapabilities=",
            "--property=PrivateTmp=yes",
            "--property=PrivateDevices=yes",
            "--property=ProtectSystem=strict",
            "--property=ProtectHome=tmpfs",
            "--property=ProtectKernelTunables=yes",
            "--property=ProtectKernelModules=yes",
            "--property=ProtectKernelLogs=yes",
            "--property=ProtectControlGroups=yes",
            "--property=LockPersonality=yes",
            "--property=RestrictSUIDSGID=yes",
            "--property=MemoryMax=4G",
            "--property=TasksMax=64",
            "--property=OOMPolicy=kill",
            "--property=IPAddressDeny=any",
            "--property=IPAccounting=yes",
            f"--property=StandardInput=file:/proc/{os.getpid()}/fd/{input_fd}",
            f"--property=StandardOutput=file:/proc/{os.getpid()}/fd/{output_fd}",
            "--property=StandardError=journal",
            f"--property=EnvironmentFile={env_path}",
        ]
        if network_policy == "loopback":
            systemd_args.extend(
                (
                    "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6",
                    "--property=IPAddressAllow=127.0.0.0/8",
                    "--property=IPAddressAllow=::1/128",
                )
            )
        else:
            systemd_args.append("--property=RestrictAddressFamilies=AF_UNIX")
        process = subprocess.Popen([*systemd_args, "--", resolved_command])
        deadline = time.monotonic() + 15
        while process.poll() is None:
            state = subprocess.run(
                [
                    "/usr/bin/systemctl",
                    "show",
                    "--property=ActiveState",
                    "--value",
                    unit_name,
                ],
                check=False,
                capture_output=True,
                text=True,
            ).stdout.strip()
            if state == "active":
                # Type=exec becomes active only after systemd has loaded the
                # EnvironmentFile and successfully execve'd the add-on.
                env_path.unlink(missing_ok=True)
                env_path = None
                break
            if time.monotonic() >= deadline:
                process.terminate()
                fail("transient add-on unit did not become active")
            time.sleep(0.05)
        status = process.wait()
        return status
    finally:
        if env_path is not None:
            env_path.unlink(missing_ok=True)
        for fd in (input_fd, output_fd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass


if __name__ == "__main__":
    raise SystemExit(main())
