#!/usr/bin/env bash
# Root-owned broker for first-party stdio MCP add-ons.
#
# The gateway may invoke only this helper through a command-specific sudoers
# rule. The helper validates the backend/command pair, copies only the exact
# approved environment names into a root-only transient EnvironmentFile, and
# launches the add-on in a resource-bounded systemd service with default-deny
# IP egress and the sift-addon AppArmor profile.
set -Eeuo pipefail

die() {
  printf 'sift-addon-systemd-sandbox: %s\n' "$*" >&2
  exit 2
}

[[ "${EUID}" -eq 0 ]] || die "must run as root"
service_user="${SUDO_USER:-}"
[[ "$service_user" =~ ^[a-z_][a-z0-9_-]*[$]?$ && "$service_user" != root ]] \
  || die "invalid invoking service user"
service_group="$(id -gn "$service_user" 2>/dev/null)" || die "service user not found"

backend_name=""
network_policy=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend-name) backend_name="${2:-}"; shift 2 ;;
    --network-policy) network_policy="${2:-}"; shift 2 ;;
    --) shift; break ;;
    *) die "unknown option" ;;
  esac
done

[[ "$backend_name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "invalid backend name"
[[ "$network_policy" == none || "$network_policy" == loopback ]] \
  || die "invalid network policy"
[[ $# -eq 1 ]] || die "approved add-ons do not accept command arguments"

command_path="$1"
[[ "$command_path" == /* && -x "$command_path" ]] || die "command must be absolute and executable"
resolved_command="$(realpath "$command_path")" || die "command cannot be resolved"
case "$resolved_command" in
  /opt/sift-mcps/.venv/bin/opensearch-mcp)
    [[ "$backend_name" == opensearch-mcp && "$network_policy" == loopback ]] \
      || die "OpenSearch backend policy mismatch"
    approved_env=(OPENSEARCH_CONFIG OPENSEARCH_HOST)
    ;;
  /opt/sift-mcps/.venv/bin/windows-triage-mcp)
    [[ "$backend_name" == windows-triage-mcp && "$network_policy" == none ]] \
      || die "Windows-triage backend policy mismatch"
    approved_env=(WT_DATA_DIR)
    ;;
  /opt/sift-mcps/.venv/bin/opencti-mcp)
    [[ "$backend_name" == opencti-mcp && "$network_policy" == loopback ]] \
      || die "OpenCTI backend policy mismatch"
    approved_env=(OPENCTI_URL OPENCTI_TOKEN)
    ;;
  *) die "command is not an approved installed add-on launcher" ;;
esac

install -d -o root -g root -m 0700 /run/sift-addon
env_file="$(mktemp /run/sift-addon/environment.XXXXXX)"
chmod 0600 "$env_file"
cleanup() { rm -f "$env_file"; }
trap cleanup EXIT

write_env() {
  local name="$1" value="${!1:-}"
  [[ -n "$value" ]] || return 0
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "environment value contains a newline"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s="%s"\n' "$name" "$value" >>"$env_file"
}
for env_name in "${approved_env[@]}"; do
  write_env "$env_name"
done
printf 'HOME="/tmp"\nUSER="%s"\nLOGNAME="%s"\n' \
  "$service_user" "$service_user" >>"$env_file"

systemd_args=(
  --pipe --wait --quiet --collect --service-type=exec
  --property="User=${service_user}"
  --property="Group=${service_group}"
  --property=AppArmorProfile=sift-addon
  --property=NoNewPrivileges=yes
  --property=CapabilityBoundingSet=
  --property=AmbientCapabilities=
  --property=PrivateTmp=yes
  --property=PrivateDevices=yes
  --property=ProtectSystem=strict
  --property=ProtectHome=tmpfs
  --property=ProtectKernelTunables=yes
  --property=ProtectKernelModules=yes
  --property=ProtectKernelLogs=yes
  --property=ProtectControlGroups=yes
  --property=LockPersonality=yes
  --property=RestrictSUIDSGID=yes
  --property=MemoryMax=4G
  --property=TasksMax=64
  --property=OOMPolicy=kill
  --property=IPAddressDeny=any
  --property=IPAccounting=yes
  --property="EnvironmentFile=${env_file}"
)
if [[ "$network_policy" == loopback ]]; then
  systemd_args+=(
    --property="RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6"
    --property=IPAddressAllow=127.0.0.0/8
    --property=IPAddressAllow=::1/128
  )
else
  systemd_args+=(--property="RestrictAddressFamilies=AF_UNIX")
fi

/usr/bin/systemd-run "${systemd_args[@]}" -- "$resolved_command"
