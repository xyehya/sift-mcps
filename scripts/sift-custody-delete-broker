#!/usr/bin/python3
"""Delete one descriptor-verified pending evidence entry for a Portal operation.

The command accepts no argv and a bounded JSON request on stdin. It is installed
root-owned and is reached only through an exact no-argument sudoers command plus
the Gateway's ``px`` transition into a dedicated AppArmor profile. It uses a
root-only, least-privilege broker DSN and broker-only Postgres RPCs, then drops
to the service UID before reopening the configured direct entry without
following links. It rejects immutable/linked files and rechecks all prepared
facts before unlink. It is not an MCP tool.
"""

from __future__ import annotations

import array
import fcntl
import hashlib
import json
import os
import pwd
import re
import stat
import sys
import uuid
from pathlib import Path
from typing import Any, NoReturn

CONFIG = Path("/etc/sift/custody-delete.json")
BROKER_DSN_FILE = Path("/etc/sift/custody-delete-dsn")
ROOT_PYTHON_DEPS = Path("/usr/local/lib/sift/prepare-evidence-python")
EXPECTED_PROFILE = "sift-custody-delete-broker (enforce)"
MAX_REQUEST_BYTES = 8192
FS_IOC_GETFLAGS = 0x80086601
FS_IMMUTABLE_FL = 0x00000010
CASE_KEY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
NAME_RE = re.compile(r"^[^/\\\x00]{1,255}$")
SHA256_RE = re.compile(r"^sha256:[0-9a-f]{64}$")
REQUEST_KEYS = {"schema_version", "operation_id", "runner_instance_id"}


class DeleteBrokerError(RuntimeError):
    pass


def _fail(reason: str) -> NoReturn:
    raise DeleteBrokerError(reason)


def _read_json_object(path: Path) -> dict[str, Any]:
    info = path.stat(follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        _fail("configuration_type_or_owner_invalid")
    if stat.S_IMODE(info.st_mode) & 0o022:
        _fail("configuration_is_writable")
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        _fail("configuration_invalid")
    return value


def load_config(path: Path = CONFIG) -> tuple[Path, pwd.struct_passwd]:
    value = _read_json_object(path)
    if set(value) != {"cases_root", "service_user"}:
        _fail("configuration_keys_invalid")
    cases_root = Path(str(value["cases_root"]))
    if not cases_root.is_absolute() or cases_root == Path("/"):
        _fail("cases_root_invalid")
    service = pwd.getpwnam(str(value["service_user"]))
    return cases_root, service


def parse_request(raw: bytes) -> dict[str, Any]:
    if not raw or len(raw) > MAX_REQUEST_BYTES:
        _fail("request_size_invalid")
    value = json.loads(raw.decode("utf-8"))
    if not isinstance(value, dict) or set(value) != REQUEST_KEYS:
        _fail("request_shape_invalid")
    if value["schema_version"] != 1:
        _fail("request_schema_invalid")
    try:
        uuid.UUID(str(value["operation_id"]))
    except ValueError:
        _fail("operation_id_invalid")
    runner = value["runner_instance_id"]
    if not isinstance(runner, str) or not (1 <= len(runner) <= 256):
        _fail("runner_instance_invalid")
    return value


def _activate_root_owned_dependencies(path: Path = ROOT_PYTHON_DEPS) -> None:
    root_info = path.stat(follow_symlinks=False)
    if not stat.S_ISDIR(root_info.st_mode) or root_info.st_uid != 0 or stat.S_IMODE(root_info.st_mode) & 0o022:
        _fail("dependency_root_invalid")
    for child in path.rglob("*"):
        info = child.lstat()
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
            _fail("dependency_entry_invalid")
    sys.path.insert(0, str(path))


def _read_broker_dsn(path: Path = BROKER_DSN_FILE) -> str:
    info = path.stat(follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        _fail("broker_dsn_owner_or_type_invalid")
    if stat.S_IMODE(info.st_mode) != 0o600:
        _fail("broker_dsn_mode_invalid")
    dsn = path.read_text(encoding="utf-8").strip()
    if not dsn or "\n" in dsn:
        _fail("broker_dsn_invalid")
    return dsn


def resolve_operation(
    dsn: str, operation_id: str, runner_instance_id: str, cases_root: Path
) -> dict[str, Any]:
    import psycopg

    with psycopg.connect(dsn) as conn, conn.cursor() as cur:
        cur.execute(
            "select sift_custody_broker.authorize(%s,%s)",
            (operation_id, runner_instance_id),
        )
        row = cur.fetchone()
    if not row or not isinstance(row[0], dict):
        _fail("operation_not_found")
    authority = row[0]
    item = authority.get("item")
    if not isinstance(item, dict):
        _fail("operation_facts_invalid")
    if authority.get("operation_id") != operation_id or authority.get("runner_instance_id") != runner_instance_id:
        _fail("operation_authority_invalid")
    case_key = str(authority.get("case_key") or "")
    if not CASE_KEY_RE.fullmatch(case_key) or case_key in {".", ".."}:
        _fail("case_key_invalid")
    if Path(str(authority.get("legacy_case_dir"))) != cases_root / case_key:
        _fail("case_directory_binding_invalid")
    display_path = str(authority.get("display_path") or "")
    path_parts = Path(display_path).parts
    if len(path_parts) != 2 or path_parts[0] != "evidence":
        _fail("display_path_invalid")
    name = path_parts[1]
    if not NAME_RE.fullmatch(name) or name in {".", ".."}:
        _fail("name_invalid")
    if (
        item.get("display_path") != display_path
        or item.get("present") is not True
        or not SHA256_RE.fullmatch(str(item.get("sha256")))
    ):
        _fail("pending_object_binding_invalid")
    for key in ("bytes", "st_dev", "st_ino"):
        value = item.get(key)
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            _fail(f"{key}_invalid")
    if item.get("st_nlink") != 1:
        _fail("link_count_invalid")
    facts_digest = str(authority.get("prepared_facts_sha256") or "")
    if not SHA256_RE.fullmatch(facts_digest):
        _fail("prepared_facts_digest_invalid")
    return {
        "operation_id": operation_id,
        "runner_instance_id": runner_instance_id,
        "prepared_facts_sha256": facts_digest,
        "receipt_claimed": authority.get("receipt_claimed") is True,
        "receipt_completed": authority.get("receipt_completed") is True,
        "receipt_runner_instance_id": authority.get("receipt_runner_instance_id"),
        "case_key": case_key,
        "name": name,
        **item,
    }


def claim_operation(dsn: str, operation: dict[str, Any]) -> None:
    import psycopg

    with psycopg.connect(dsn) as conn, conn.cursor() as cur:
        cur.execute(
            "select sift_custody_broker.claim(%s,%s,%s)",
            (
                operation["operation_id"],
                operation["runner_instance_id"],
                operation["prepared_facts_sha256"],
            ),
        )
        row = cur.fetchone()
        if not row or not isinstance(row[0], dict) or row[0].get("claimed") is not True:
            _fail("broker_claim_conflict")


def complete_operation(dsn: str, operation: dict[str, Any]) -> None:
    import psycopg

    with psycopg.connect(dsn) as conn, conn.cursor() as cur:
        cur.execute(
            "select sift_custody_broker.complete(%s,%s,%s)",
            (
                operation["operation_id"],
                operation["runner_instance_id"],
                operation["prepared_facts_sha256"],
            ),
        )
        row = cur.fetchone()
        if not row or not isinstance(row[0], dict) or row[0].get("completed") is not True:
            _fail("broker_completion_conflict")


def _open_dir(path_or_name: Path | str, *, dir_fd: int | None = None) -> int:
    return os.open(
        path_or_name,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
        dir_fd=dir_fd,
    )


def _immutable(fd: int) -> bool:
    flags = array.array("I", [0])
    fcntl.ioctl(fd, FS_IOC_GETFLAGS, flags, True)
    return bool(flags[0] & FS_IMMUTABLE_FL)


def _hash_fd(fd: int) -> tuple[str, int]:
    digest = hashlib.sha256()
    total = 0
    offset = 0
    while True:
        chunk = os.pread(fd, 1024 * 1024, offset)
        if not chunk:
            break
        digest.update(chunk)
        total += len(chunk)
        offset += len(chunk)
    return "sha256:" + digest.hexdigest(), total


def delete_verified(
    operation: dict[str, Any], cases_root: Path, service: pwd.struct_passwd, dsn: str
) -> None:
    root_fd = case_fd = evidence_fd = target_fd = None
    try:
        root_fd = _open_dir(cases_root)
        case_fd = _open_dir(str(operation["case_key"]), dir_fd=root_fd)
        evidence_fd = _open_dir("evidence", dir_fd=case_fd)
        try:
            target_fd = os.open(
                str(operation["name"]),
                os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
                dir_fd=evidence_fd,
            )
        except FileNotFoundError:
            if not operation["receipt_claimed"]:
                _fail("missing_without_broker_claim")
            # A lost broker response or lost Gateway phase advance may retry
            # after the one-way completion was already recorded. That exact
            # completed receipt is terminal proof; never issue a forbidden
            # second UPDATE against the immutable receipt row.
            if not operation["receipt_completed"]:
                complete_operation(dsn, operation)
            return
        before = os.fstat(target_fd)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            _fail("regular_single_link_required")
        if _immutable(target_fd):
            _fail("immutable_evidence_refused")
        digest, size = _hash_fd(target_fd)
        expected = (operation["st_dev"], operation["st_ino"], operation["st_nlink"])
        observed = (before.st_dev, before.st_ino, before.st_nlink)
        if observed != expected or digest != operation["sha256"] or size != operation["bytes"]:
            _fail("prepared_facts_changed")
        entry = os.stat(str(operation["name"]), dir_fd=evidence_fd, follow_symlinks=False)
        if (entry.st_dev, entry.st_ino) != (before.st_dev, before.st_ino):
            _fail("directory_entry_changed")
        if operation["receipt_completed"]:
            _fail("completed_receipt_target_present")

        if os.geteuid() != service.pw_uid or os.getegid() != service.pw_gid:
            _fail("service_identity_required")
        claim_operation(dsn, operation)
        os.unlink(str(operation["name"]), dir_fd=evidence_fd)
        os.fsync(evidence_fd)
        complete_operation(dsn, operation)
    finally:
        for fd in (target_fd, evidence_fd, case_fd, root_fd):
            if fd is not None:
                os.close(fd)


def main() -> int:
    try:
        if sys.argv != [sys.argv[0]] or os.geteuid() != 0:
            _fail("fixed_root_command_required")
        label = Path("/proc/self/attr/current").read_text(encoding="utf-8").strip()
        if label != EXPECTED_PROFILE:
            _fail("apparmor_profile_not_enforced")
        request = parse_request(sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1))
        cases_root, service = load_config()
        if service.pw_uid == 0:
            _fail("service_identity_is_root")
        _activate_root_owned_dependencies()
        dsn = _read_broker_dsn()
        operation = resolve_operation(
            dsn,
            str(request["operation_id"]),
            str(request["runner_instance_id"]),
            cases_root,
        )
        os.setgroups([])
        os.setgid(service.pw_gid)
        os.setuid(service.pw_uid)
        if os.geteuid() != service.pw_uid or os.getegid() != service.pw_gid:
            _fail("identity_drop_failed")
        delete_verified(operation, cases_root, service, dsn)
        print('{"removed":true,"schema_version":1}')
        return 0
    except Exception:
        # Stable, path-free output. The Portal receives only a generic broker
        # rejection even for database/driver failures; kernel audit and the
        # durable operation retain attribution. This privileged helper always
        # fails closed instead of exposing paths, SQL, or connection details.
        print("custody_delete_rejected", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
